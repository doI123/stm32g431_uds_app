*.obj
*.elf
*.bin
*.hex
*.map
*.lst
*.crf
*.dep
*.su
*.i

# ---- 编辑器 / IDE ----
.vs/
*.uvguix.*
*.uvoptx
*.scvd
*.bak
*.orig
*.rej
*~
*.tmp

# ---- Python（tools/*.py 的缓存） ----
__pycache__/
*.pyc

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
